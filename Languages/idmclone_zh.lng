; Archivo de idioma de IDMClone: chino simplificado (简体中文).
; Formato: texto en español=traducción. %s = cualquier texto, %d = número. \n = salto de línea, \= = signo igual.
; Lo que no esté aquí se queda en español. Para otro idioma, copia este archivo como idmclone_<código>.lng
; en la carpeta Languages (junto a IDMClone.exe) o en %APPDATA%\IDMClone\Languages y traduce lo de la derecha.
[IDMClone]
LANGUAGE=简体中文
CODE=zh
AUTHOR=IDMClone
[Textos]
