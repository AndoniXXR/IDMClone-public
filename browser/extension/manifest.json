{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "2.0",
  "description": "__MSG_extDesc__",
  "default_locale": "es",
  "minimum_chrome_version": "121",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "idmclone@idmclone.local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "nativeMessaging",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/util.js",
      "lib/i18n.js",
      "lib/decide.js",
      "lib/media.js",
      "lib/subtitles.js",
      "lib/links.js",
      "lib/sites.js",
      "bg/core.js",
      "bg/host.js",
      "bg/config.js",
      "bg/cookies.js",
      "bg/capture.js",
      "bg/menus.js",
      "bg/links.js",
      "bg/media-store.js",
      "bg/media-net.js",
      "bg/sites.js",
      "bg/youtube.js",
      "bg/main.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/util.js",
        "lib/i18n.js",
        "lib/media.js",
        "lib/subtitles.js",
        "lib/links.js",
        "lib/sites.js",
        "content/ui.js",
        "content/keys.js",
        "content/selection-panel.js",
        "content/tracker.js",
        "content/video-panel.js",
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.vimeo.com/*",
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "page/hooks.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
